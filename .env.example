# ── PostgreSQL ───────────────────────────────────────────────────────────
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=analytics
PG_PASSWORD=analytics123
PG_DATABASE=pool_analytics
PG_SCHEMA=pool_analytics

# ── EVM / Uniswap (archive node required for historical TVL) ─────────────
EVM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Analytics collector ─────────────────────────────────────────────────
COLLECTOR_DISCOVERY_MODE=mainstream
COLLECTOR_PROTOCOLS=v2,v3
COLLECTOR_BASE_ASSETS=WETH,USDT
COLLECTOR_BUCKET_SECONDS=3600
COLLECTOR_CONCURRENCY=12
COLLECTOR_RPC_RETRIES=2
COLLECTOR_RECORD_RAW_EVENTS=false

# ── Historical backfill ──────────────────────────────────────────────────
# Earliest hour to backfill prices + pool analytics from (UTC ISO 8601).
BACKFILL_START_ISO=2026-01-01T00:00:00Z

# ── Analytics server ────────────────────────────────────────────────────
ANALYTICS_PORT=3000

# ── Token-flow pipeline (ClickHouse → Postgres; separate from pool pipeline) ──
# ClickHouse HTTP endpoint + credentials (never commit real values).
CLICKHOUSE_HOST=http://10.8.6.153:5886
CLICKHOUSE_USER=test
CLICKHOUSE_PASSWORD=
# Aggregation start; defaults to BACKFILL_START_ISO when unset. No rolling prune.
FLOW_START_ISO=2026-01-01T00:00:00Z
FLOW_CHAIN_ID=1

# ── Staking history pipeline (chaincloud-fe unstake DB → Postgres) ───────
# Source PostgreSQL URL used by chaincloud-fe's DATABASE_UNSTAKE_URL.
DATABASE_UNSTAKE_URL=postgresql://user:password@host:5432/database
# Earliest UTC day to sync ETH/TRON stake, unstake, and withdrawal history.
STAKE_START_ISO=2026-01-01T00:00:00Z
STAKE_CHAINS=eth,tron
STAKE_BATCH_DAYS=14
# Set true only when you intentionally want the startup sync to delete and
# rebuild local staking rows for the selected date range.
STAKE_FULL_REFRESH=false
STAKE_SYNC_INTERVAL_SECONDS=3600
